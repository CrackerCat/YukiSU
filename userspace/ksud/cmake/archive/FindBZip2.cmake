if(NOT TARGET ksud_bzip2)
    message(FATAL_ERROR "The pinned bzip2 target is required")
endif()
if(NOT TARGET BZip2::BZip2)
    add_library(BZip2::BZip2 ALIAS ksud_bzip2)
endif()
set(BZIP2_FOUND TRUE)
set(BZIP2_VERSION_STRING 1.0.8)
set(BZIP2_INCLUDE_DIRS "${ksud_bzip2_SOURCE_DIR}")
set(BZIP2_LIBRARIES ksud_bzip2)
